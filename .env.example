# ─────────────────────────────────────────────────────────────────────
#  Ninguna de estas variables es obligatoria: la herramienta funciona
#  sin configurar nada. Copia este fichero a .env.local para el desarrollo
#  en local, y usa Settings -> Environment Variables en Vercel.
# ─────────────────────────────────────────────────────────────────────

# Dónde aterrizan los datos de quien descarga la lista (nombre, teléfono,
# correo). Es la URL de tu aplicación web de Google Apps Script y termina
# en /exec. Instrucciones paso a paso en APPS_SCRIPT.md.
#
# SIN ESTA VARIABLE NO CAPTURAS NINGÚN CONTACTO: la herramienta sigue
# funcionando y la gente se descarga su lista, pero tú no te enteras.
SHEETS_WEBHOOK_URL=

# Clave de Hunter.io de respaldo, SOLO para desarrollo en local.
# NO la pongas en Vercel: son 50 búsquedas al mes en total y entre todos
# los visitantes se agotan el primer día. En producción cada persona pega
# su propia clave gratuita en la interfaz.
HUNTER_API_KEY=
